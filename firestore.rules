rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السعر هنا يجب أن يطابق REW.PRICE في js/rewards.js
    function price() { return 750; }
    function ids() { return ['khwarizmi','idrisi','farabi','biruni','haithm','sina','maqrizi','razi']; }
    // تاريخ اليوم بصيغة YYYY-MM-DD (توقيت القاهرة: نقبل UTC+2 أو UTC+3 بسبب التوقيت الصيفي)
    function dayStr(t) {
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()) + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function todayOK(s) {
      return s == dayStr(request.time + duration.value(2, 'h')) || s == dayStr(request.time + duration.value(3, 'h'));
    }
    // الشعلة وتحدي اليوم: يتغيّر كل منهما مرة واحدة في اليوم وبزيادة لا تتجاوز ١
    function fireOK(o, n) {
      return (n.get('fire', 0) == o.get('fire', 0) && n.get('fireDay', '') == o.get('fireDay', ''))
        || (todayOK(n.get('fireDay', '')) && n.get('fireDay', '') != o.get('fireDay', '') && n.get('fire', 0) >= 1 && n.get('fire', 0) <= o.get('fire', 0) + 1);
    }
    function chalOK(o, n) {
      return (n.get('chDay', '') == o.get('chDay', '') && n.get('chWins', 0) == o.get('chWins', 0))
        || (todayOK(n.get('chDay', '')) && n.get('chDay', '') != o.get('chDay', '') && n.get('chWins', 0) <= o.get('chWins', 0) + 1);
    }
    function dailySame(o, n) {
      return n.get('fire', 0) == o.get('fire', 0) && n.get('fireDay', '') == o.get('fireDay', '')
        && n.get('chDay', '') == o.get('chDay', '') && n.get('chWins', 0) == o.get('chWins', 0);
    }
    function schema(n) {
      return n.keys().hasOnly(['name','points','coins','pfp','owned','done','ach','bd','wkKey','wkP','moKey','moP','streak','lastDay','fire','fireDay','chDay','chOk','chWins','log','t'])
        && n.get('fire', 0) is int && n.get('fireDay', '') is string && n.get('chDay', '') is string && n.get('chWins', 0) is int
        && n.name is string && n.name.size() >= 2 && n.name.size() <= 20
        && n.owned.size() <= 8 && n.owned.hasOnly(ids()) && n.log.size() <= 8
        && (n.pfp == 'default' || n.pfp in n.owned)
        && n.t == request.time;
    }
    function win(o, n, k, v) { return n[k] == o[k] ? (n[v] >= o[v] && n[v] - o[v] <= 400) : n[v] <= 400; }
    // كسب نقاط: زيادة محدودة في كل عملية، وفاصل ثانيتين بين العمليات
    function earn(o, n) {
      return n.owned == o.owned && n.pfp == o.pfp && n.name == o.name
        && request.time > o.t + duration.value(2, 's')
        && n.points >= o.points && n.points - o.points <= 400
        && n.coins >= o.coins && n.coins - o.coins <= 400
        && win(o, n, 'wkKey', 'wkP') && win(o, n, 'moKey', 'moP')
        && n.streak <= o.streak + 1
        && fireOK(o, n) && chalOK(o, n);
    }
    // شراء صورة: يخصم السعر بالضبط ويضيف صورة واحدة
    function buy(o, n) {
      return n.coins == o.coins - price() && n.points == o.points && n.wkP == o.wkP && n.moP == o.moP
        && n.owned.size() == o.owned.size() + 1 && n.owned.hasAll(o.owned) && dailySame(o, n);
    }
    // تغيير الصورة المستخدمة أو الاسم فقط
    function settings(o, n) {
      return n.points == o.points && n.coins == o.coins && n.owned == o.owned
        && n.wkP == o.wkP && n.moP == o.moP && n.done == o.done && n.ach == o.ach && dailySame(o, n);
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid && schema(request.resource.data)
        && request.resource.data.points == 0 && request.resource.data.coins == 0
        && request.resource.data.owned.size() == 0 && request.resource.data.pfp == 'default'
        && request.resource.data.wkP == 0 && request.resource.data.moP == 0
        && request.resource.data.get('fire', 0) == 0 && request.resource.data.get('chWins', 0) == 0;
      allow update: if request.auth.uid == uid && schema(request.resource.data)
        && (earn(resource.data, request.resource.data) || buy(resource.data, request.resource.data) || settings(resource.data, request.resource.data));
      allow delete: if false;
    }
    // لوحة الشرف: وثيقة لكل يوم فيها أول ثلاثة مجيبين (قوائم متوازية: u المعرّفات، n الأسماء، p الصور)
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    match /daily/{day} {
      allow read: if true;
      allow create: if request.auth != null && todayOK(day)
        && request.resource.data.keys().hasOnly(['u','n','p','t'])
        && request.resource.data.u == [request.auth.uid] && request.resource.data.n == [me().name] && request.resource.data.p == [me().pfp]
        && request.resource.data.t == request.time;
      allow update: if request.auth != null && todayOK(day)
        && request.resource.data.keys().hasOnly(['u','n','p','t'])
        && resource.data.u.size() < 3 && !(request.auth.uid in resource.data.u)
        && request.resource.data.u == resource.data.u.concat([request.auth.uid])
        && request.resource.data.n == resource.data.n.concat([me().name])
        && request.resource.data.p == resource.data.p.concat([me().pfp])
        && request.resource.data.t == request.time;
      allow delete: if false;
    }
  }
}
